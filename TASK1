
# University Scholarship Allocation System

MIN_AGGREGATE = 75
MIN_SUBJECT_MARKS = 60
MIN_ATTENDANCE = 75
MAX_INCOME = 250000

applicants = []

n = int(input("Enter number of applicants: "))
subjects = int(input("Enter number of subjects: "))

for i in range(n):
    print(f"\nEnter details of applicant {i + 1}")

    name = input("Enter student name: ")

    marks = []
    for j in range(subjects):
        mark = float(input(f"Enter marks in subject {j + 1}: "))
        marks.append(mark)

    attendance = float(input("Enter attendance percentage: "))
    income = float(input("Enter annual family income: "))

    aggregate = sum(marks) / subjects

    eligible = (
        aggregate >= MIN_AGGREGATE
        and all(mark >= MIN_SUBJECT_MARKS for mark in marks)
        and attendance >= MIN_ATTENDANCE
        and income <= MAX_INCOME
    )

    student = {
        "name": name,
        "aggregate": aggregate,
        "attendance": attendance,
        "income": income,
        "eligible": eligible
    }

    applicants.append(student)

# Sort eligible students by the predefined tie-breaking rules
eligible_students = [
    student for student in applicants if student["eligible"]
]

eligible_students.sort(
    key=lambda s: (
        -s["aggregate"],
        -s["attendance"],
        s["income"]
    )
)

print("\n--- SCHOLARSHIP ELIGIBILITY RESULTS ---")

for student in applicants:
    status = "Eligible" if student["eligible"] else "Not Eligible"
    print(f"{student['name']}: {status}")

print("\n--- SCHOLARSHIP RANKING ---")

if eligible_students:
    for rank, student in enumerate(eligible_students, start=1):
        print(
            f"Rank {rank}: {student['name']} | "
            f"Aggregate: {student['aggregate']:.2f}% | "
            f"Attendance: {student['attendance']:.2f}% | "
            f"Income: Rs. {student['income']:.2f}"
        )
else:
    print("No eligible students found.")

