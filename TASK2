bills = []
n = int(input("Enter months: "))
for i in range(n):
    u = float(input("Enter units: "))
    if u <= 100:
        e = u * 2
    elif u <= 200:
        e = 200 + (u - 100) * 3
    elif u <= 300:
        e = 500 + (u - 200) * 5
    else:
        e = 1000 + (u - 300) * 7
    s = e * 0.05
    r = e * 0.10 if u <= 100 else 0
    bill = e + 100 + s - r
    bills.append(bill)
    print("Bill: Rs.", round(bill, 2))
for i in range(1, n):
    change = (bills[i] - bills[i-1]) / bills[i-1] * 100
    print("Increase:", round(change, 2), "%")
    if change > 25:
        print("Unusual increase!")
