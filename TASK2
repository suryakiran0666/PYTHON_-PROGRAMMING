
# Progressive Electricity Billing System

FIXED_CHARGE = 100
SURCHARGE_RATE = 0.05
REBATE_RATE = 0.10
INCREASE_LIMIT = 25

bills = []

months = int(input("Enter number of months: "))

for i in range(months):
    print("\nMonth", i + 1)
    units = float(input("Enter electricity consumption in units: "))

    # Calculate energy charges using progressive slabs
    if units <= 100:
        energy = units * 2
    elif units <= 200:
        energy = 100 * 2 + (units - 100) * 3
    elif units <= 300:
        energy = 100 * 2 + 100 * 3 + (units - 200) * 5
    else:
        energy = 100 * 2 + 100 * 3 + 100 * 5 + (units - 300) * 7

    # Calculate surcharge
    surcharge = energy * SURCHARGE_RATE

    # Calculate rebate
    if units <= 100:
        rebate = energy * REBATE_RATE
    else:
        rebate = 0

    # Calculate final bill
    total = energy + FIXED_CHARGE + surcharge - rebate

    bills.append({
        "month": i + 1,
        "units": units,
        "energy": energy,
        "surcharge": surcharge,
        "rebate": rebate,
        "total": total
    })

# Display monthly bills
print("\n--- MONTHLY ELECTRICITY BILLS ---")

for bill in bills:
    print("\nMonth:", bill["month"])
    print("Units Consumed:", bill["units"])
    print("Energy Charges: Rs.", round(bill["energy"], 2))
    print("Fixed Charges: Rs.", FIXED_CHARGE)
    print("Surcharge: Rs.", round(bill["surcharge"], 2))
    print("Rebate: Rs.", round(bill["rebate"], 2))
    print("Final Bill: Rs.", round(bill["total"], 2))

# Compare consecutive monthly bills
print("\n--- MONTHLY BILL COMPARISON ---")

if len(bills) < 2:
    print("At least two months are required for comparison.")
else:
    for i in range(1, len(bills)):
        previous = bills[i - 1]["total"]
        current = bills[i]["total"]

        change = (current - previous) / previous * 100

        print(
            "Month", bills[i]["month"],
            "change:", round(change, 2), "%"
        )

        if change > INCREASE_LIMIT:
            print("Warning: Unusual increase detected!")
        else:
            print("No unusual increase detected.")
