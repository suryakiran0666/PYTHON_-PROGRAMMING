c = float(input("Consultation charge: "))
d = float(input("Diagnostic charge: "))
t = float(input("Treatment charge: "))
p = float(input("Payment amount: "))
bill = c + d + t
if bill > 5000:
    bill *= 0.90
print("Final Bill: Rs.", round(bill, 2))
if p < 0:
    print("Invalid payment")
elif p >= bill:
    print("Fully Paid")
else:
    print("Payment Pending")
